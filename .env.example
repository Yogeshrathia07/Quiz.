# A long random value (32+ characters). A server on a public https address
# refuses to start without one. Make one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-with-a-long-random-secret
PORT=3000
# A local mongod or a MongoDB Atlas connection string. The database name in the
# URI is created automatically on first use.
MONGODB_URI=mongodb://127.0.0.1:27017/campus_quiz
# These limits are per Node worker. Six workers use at most 300 connections at
# the default, so keep the combined value within the Atlas tier's allowance.
MONGODB_MAX_POOL_SIZE=50
MONGODB_MAX_CONNECTING=8

# Optional for one Node process. Required for PM2 cluster mode or multiple app
# servers. Redis stores temporary distributed locks only; permanent data stays
# in MongoDB Atlas. Use rediss:// for a TLS-managed Redis service.
REDIS_URL=
REDIS_KEY_PREFIX=campus-quiz
# Normally leave these defaults unchanged.
REDIS_LOCK_TTL_MS=30000
REDIS_LOCK_WAIT_MS=15000
REDIS_CONNECT_TIMEOUT_MS=8000
# Shared copy of test settings. Writes invalidate it immediately; this is only
# the fallback lifetime if a cache invalidation cannot reach Redis.
REDIS_TEST_CACHE_MS=5000

# Overload protection and background Excel generation. Polls are refused
# before answer/submission writes when active requests pass the soft limit.
SOFT_ACTIVE_REQUESTS=600
HARD_ACTIVE_REQUESTS=8000
EXPORT_WORKERS=1
EXPORT_QUEUE_LIMIT=24

# Required when students scan the QR from their phones. Use this computer's LAN URL
# (for example http://192.168.1.25:3000) or your deployed HTTPS URL. Leave blank
# only when testing in this browser on the same computer.
PUBLIC_BASE_URL=

# Email one-time-code sign-in, sent through Brevo (free: 300 emails a day).
# MAIL_FROM_EMAIL must be a sender verified in Brevo. Without an API key, a
# development server prints codes to its console instead.
BREVO_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Quiz Portal
# Stop sending codes after this many in 24 hours (Brevo's free limit is 300).
OTP_DAILY_LIMIT=295

# Only addresses at this domain or its subdomains can sign in.
ALLOWED_EMAIL_DOMAIN=upes.ac.in
# Addresses at this domain are students; every other allowed address is
# faculty (their own admin portal, and they can take tests too). Guest access
# is not configured here: each test's admin decides it on that test.
STUDENT_DOMAIN=stu.upes.ac.in
# Faculty allowed to open the Users page (comma-separated). Empty = all faculty,
# which lets any faculty account block or delete any other: name them here.
ADMIN_EMAIL=

# Optional Microsoft sign-in for students and faculty. The Azure app must be
# multi-tenant ("Multiple Entra ID tenants") with redirect URI
# <PUBLIC_BASE_URL>/auth/microsoft/callback, and AZURE_TENANT_ID=organizations.
AZURE_TENANT_ID=organizations
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Only accounts from these Microsoft directories (comma-separated tenant IDs).
# Set this whenever AZURE_TENANT_ID is organizations: an account's own email
# field is then trusted only from these directories (any other signs in by its
# verified principal name).
AZURE_ALLOWED_TENANTS=

# One login at a time: signing in logs the account out of its other devices.
# students (default) = student accounts only, all = faculty too, off = no limit.
SINGLE_LOGIN=students

# Time lost to a server outage mid-test is given back, for outages up to this many minutes.
OUTAGE_EXTEND_MAX_MINUTES=30

# A registration request nobody approves within this many minutes is removed
# automatically; the student can simply ask again. 0 keeps requests until decided.
PENDING_REQUEST_MINUTES=60
